<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="default" transaction-type="JTA">

        <jta-data-source>java:jboss/datasources/TherapyDraft</jta-data-source>

        <class>com.soulware.therapydraft.domain.model.aggregates.Assessment</class>
        <class>com.soulware.therapydraft.domain.model.aggregates.TherapyPlan</class>

        <properties>
            <!-- Hibernate/JPA -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/therapy-draft?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"/>
        </properties>

    </persistence-unit>
</persistence>
